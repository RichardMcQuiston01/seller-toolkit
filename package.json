{
  "name": "@richardmcquiston01/seller-toolkit",
  "version": "0.0.0",
  "description": "Framework-agnostic TypeScript toolkit for Etsy sellers: review-window estimates, policy-safe thank-you message drafting, sales and listing analytics, and report builders (HTML/CSV). Built on @richardmcquiston01/etsy-api. Never contacts buyers. Not affiliated with Etsy, Inc.",
  "keywords": [
    "etsy",
    "etsy-seller",
    "etsy-api",
    "review-window",
    "thank-you-message",
    "seller-tools",
    "analytics",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston (https://richardmcquiston.com/)",
  "homepage": "https://github.com/RichardMcQuiston01/seller-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/seller-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/seller-toolkit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "review-window": [
        "./dist/review-window.d.cts"
      ],
      "thank-you": [
        "./dist/thank-you.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./review-window": {
      "import": {
        "types": "./dist/review-window.d.ts",
        "default": "./dist/review-window.js"
      },
      "require": {
        "types": "./dist/review-window.d.cts",
        "default": "./dist/review-window.cjs"
      }
    },
    "./thank-you": {
      "import": {
        "types": "./dist/thank-you.d.ts",
        "default": "./dist/thank-you.js"
      },
      "require": {
        "types": "./dist/thank-you.d.cts",
        "default": "./dist/thank-you.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
